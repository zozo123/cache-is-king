#!/bin/sh
set -eu
repo=zozo123/cache-is-king
os="$(uname -s | tr '[:upper:]' '[:lower:]')"
arch="$(uname -m)"
case "$os" in linux|darwin) ;; *) echo "unsupported OS: $os" >&2; exit 1;; esac
case "$arch" in x86_64|amd64) arch=amd64;; arm64|aarch64) arch=arm64;; *) echo "unsupported architecture: $arch" >&2; exit 1;; esac
version="${CACHE_IS_KING_VERSION:-latest}"
asset="cache-is-king_${os}_${arch}.tar.gz"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT INT TERM
if [ "$version" = latest ]; then base="https://github.com/$repo/releases/latest/download"; else base="https://github.com/$repo/releases/download/$version"; fi
if curl -fsSL "$base/$asset" -o "$tmp/$asset" && curl -fsSL "$base/checksums.txt" -o "$tmp/checksums.txt"; then
 expected="$(awk -v f="$asset" '$2==f{print $1}' "$tmp/checksums.txt")"
 if command -v sha256sum >/dev/null 2>&1; then actual="$(sha256sum "$tmp/$asset"|awk '{print $1}')"; else actual="$(shasum -a 256 "$tmp/$asset"|awk '{print $1}')"; fi
 [ -n "$expected" ] && [ "$actual" = "$expected" ] || { echo checksum mismatch >&2; exit 1; }
 tar -xzf "$tmp/$asset" -C "$tmp"; exec "$tmp/cache-is-king" "$@"
fi
command -v go >/dev/null 2>&1 || { echo "release unavailable and Go is not installed" >&2; exit 1; }
exec go run "github.com/$repo/cmd/cache-is-king@latest" "$@"
